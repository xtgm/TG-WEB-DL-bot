{
  "name": "tg-dualbot-cloudflare",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "check": "node --check worker.js && node --check fingerprint-v2.js && node --check functions/[[path]].js",
    "test:verification-client": "node tests/verification_client_script.test.mjs",
    "test:fingerprint-algorithm": "node tests/fingerprint_v2_algorithm.test.mjs",
    "test:fingerprint-schema": "node tests/fingerprint_v2_schema.test.mjs",
    "test:fingerprint": "npm run test:fingerprint-algorithm && npm run test:fingerprint-schema",
    "test:log-translation": "node tests/log_translation.test.mjs",
    "test:topic-isolation": "node tests/topic_isolation.test.mjs",
    "test:broadcast": "node tests/broadcast.test.mjs",
    "db:apply": "wrangler d1 execute tg-dualbot-db --file=./migrations/0001_initial.sql --remote",
    "db:upgrade:verification": "wrangler d1 execute tg-dualbot-db --file=./migrations/0002_verification_gate.sql --remote",
    "db:upgrade:topics": "wrangler d1 execute tg-dualbot-db --file=./migrations/0003_topic_mode.sql --remote",
    "db:upgrade:webrtc-identity": "wrangler d1 execute tg-dualbot-db --file=./migrations/0005_webrtc_identity.sql --remote",
    "db:upgrade:fingerprint-v2": "wrangler d1 execute tg-dualbot-db --file=./migrations/0007_fingerprint_v2.sql --remote",
    "db:upgrade:moderation": "wrangler d1 execute tg-dualbot-db --file=./migrations/0009_moderation_reason.sql --remote",
    "db:upgrade:broadcast": "wrangler d1 execute tg-dualbot-db --file=./migrations/0010_broadcast.sql --remote",
    "pages:deploy": "wrangler pages deploy public --project-name tg-dualbot-cloudflare"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
